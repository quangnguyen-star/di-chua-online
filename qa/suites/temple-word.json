{
  "_about": "Outside stop inside the v2 shell: the word opens. The month calendar and .ics live on the removed standalone booth and are covered node-side (src/lib/ics.test.ts, qa/suites/state.test.ts).",
  "schema_version": "1.1.0",
  "run_id": "temple-word",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 1,
    "video": "fail",
    "default_timeout_ms": 15000
  },
  "namespace": {
    "run_id": "temple-word",
    "email": "qa+temple-word@gomu.ai",
    "tag": "QA RUN temple-word"
  },
  "scenarios": [
    {
      "name": "Word booth: closed until opened, then reveals a word",
      "tags": [
        "word"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=outside",
          "url": "/visit?stop=outside"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Mở chữ present",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "word-open"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "not revealed yet",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "testid",
              "name": "word-revealed"
            }
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "Mở chữ",
          "target": {
            "by": "testid",
            "name": "word-open"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "revealed",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "word-revealed"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "word shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "word-text"
            }
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "Home shows the daily word and the lunar note",
      "tags": [
        "word",
        "home"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "lunar note shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "lunar-note"
            }
          }
        }
      ],
      "teardown": []
    }
  ]
}
