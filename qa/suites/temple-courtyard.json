{
  "_about": "Courtyard stop inside the v2 shell: sweep by arrow keys, no counter, no pass button, exit.",
  "schema_version": "1.1.0",
  "run_id": "temple-courtyard",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 1,
    "video": "fail",
    "default_timeout_ms": 15000
  },
  "namespace": {
    "run_id": "temple-courtyard",
    "email": "qa+temple-courtyard@gomu.ai",
    "tag": "QA RUN temple-courtyard"
  },
  "scenarios": [
    {
      "name": "Sweeping: the yard shows the pile and offers no counter, clean state or pass button",
      "tags": [
        "courtyard",
        "happy-path"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=courtyard",
          "url": "/visit?stop=courtyard"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "pile visible",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "sweep-pile"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "hint visible",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "sweep-hint"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "no pass button",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "testid",
              "name": "sweep-pass"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "no counter",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "testid",
              "name": "sweep-status"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "no clean state",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "testid",
              "name": "sweep-complete"
            }
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "Sweeping by the arrow keys does not break the yard",
      "tags": [
        "courtyard",
        "keyboard"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=courtyard",
          "url": "/visit?stop=courtyard"
        },
        {
          "kind": "action",
          "op": "press",
          "intent": "sweep right",
          "key": "ArrowRight"
        },
        {
          "kind": "action",
          "op": "press",
          "intent": "sweep left",
          "key": "ArrowLeft"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "yard still shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "sweep-yard"
            }
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "Map button on the courtyard returns home",
      "tags": [
        "courtyard",
        "nav"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=courtyard",
          "url": "/visit?stop=courtyard"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "Thoát",
          "target": {
            "by": "testid",
            "name": "visit-exit"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "map shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "temple-map"
            }
          }
        }
      ],
      "teardown": []
    }
  ]
}
