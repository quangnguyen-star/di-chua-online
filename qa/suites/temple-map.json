          "op": "click",
          "intent": "click hotspot Cổng chùa",
          "target": {
            "by": "testid",
            "name": "map-place-gate"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "landed on /visit?stop=gate",
