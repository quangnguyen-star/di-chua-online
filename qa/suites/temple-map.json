    {
      "name": "Map hotspot for Cổng chùa opens its place",
      "tags": [
        "map",
        "places"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "map is shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "temple-map"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "hotspot Cổng chùa present",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "map-place-gate"
            }
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "click hotspot Cổng chùa",
          "target": {
            "by": "testid",
            "name": "map-place-gate"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "landed on /practices/tho-2-phut",
          "expected": {
            "kind": "url_contains",
            "url": "/practices/tho-2-phut"
          }
        }
      ],
      "teardown": []
    },
