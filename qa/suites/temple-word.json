{
  "_about": "Daily word booth, month calendar and .ics. Stable-word and .ics content checks need probe modes that do not exist yet; the .ics is covered node-side by src/lib/ics.test.ts and qa/suites/state.test.ts.",
  "schema_version": "1.1.0",
  "run_id": "temple-word",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 1,
    "video": "fail",
    "default_timeout_ms": 15000
  },
  "namespace": {
    "run_id": "temple-word",
    "email": "qa+temple-word@gomu.ai",
    "tag": "QA RUN temple-word"
  },
  "scenarios": [
    {
      "name": "Word booth: closed until opened, then reveals a word",
      "tags": [
        "word"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /places/word",
          "url": "/places/word"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Mở chữ present",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "word-open"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "not revealed yet",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "testid",
              "name": "word-revealed"
            }
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "Mở chữ",
          "target": {
            "by": "testid",
            "name": "word-open"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "revealed",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "word-revealed"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "word shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "word-text"
            }
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "Month calendar is a grid with the .ics download",
      "tags": [
        "word",
        "calendar"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /places/word",
          "url": "/places/word"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "month grid",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "month-calendar"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "download button",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "ics-download"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "button text",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "ics-download"
            },
            "text": "Tải lịch mùng một và rằm (.ics)"
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "Home shows the daily word and the lunar note",
      "tags": [
        "word",
        "home"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "lunar note shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "lunar-note"
            }
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "No horizontal scroll at 360px on the word booth",
      "tags": [
        "word",
        "layout"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "measure overflow",
          "script": "browser_probe.sh",
          "args": [
            "overflow",
            "{{run_id}}",
            "/places/word"
          ],
          "capture": {
            "over": "$.overflow_px"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "not wider than viewport",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "over",
            "value": "0"
          }
        }
      ],
      "teardown": []
    }
  ]
}
