        { "kind": "assert", "op": "assert", "intent": "instruction zone present", "expected": { "kind": "visible", "target": { "by": "testid", "name": "zone-instruction" } } },
        { "kind": "assert", "op": "assert", "intent": "gate art present", "expected": { "kind": "visible", "target": { "by": "testid", "name": "gate-art" } } },
        { "kind": "assert", "op": "assert", "intent": "scene stage present", "expected": { "kind": "visible", "target": { "by": "testid", "name": "scene-stage" } } }
      ],
      "teardown": []
