{
  "_about": "Editor and reviewer workflow. Needs QA_EDITOR_* and QA_REVIEWER_* secrets (ADMIN_SEED users).",
  "schema_version": "1.1.0",
  "run_id": "temple-admin-review",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 1,
    "video": "fail",
    "default_timeout_ms": 15000
  },
  "namespace": {
    "run_id": "temple-admin-review",
    "email": "qa+temple-admin-review@gomu.ai",
    "tag": "QA RUN temple-admin-review"
  },
  "scenarios": [
    {
      "name": "Editor edits a published practice as a draft; the live version is unchanged",
      "tags": [
        "admin",
        "editor",
        "revision"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "seed a published practice",
          "script": "seed_practice.sh",
          "args": [
            "{{run_id}}",
            "live",
            "published"
          ],
          "capture": {
            "id": "$.id",
            "slug": "$.slug"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/login",
          "url": "/admin/login"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "login form",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Admin sign in",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "editor email",
          "target": {
            "by": "label",
            "name": "Email"
          },
          "value": "{{secret:QA_EDITOR_EMAIL}}"
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "editor password",
          "target": {
            "by": "label",
            "name": "Password"
          },
          "value": "{{secret:QA_EDITOR_PASSWORD}}"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "sign in",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Sign in",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "content list shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Content",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "signed in",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "button",
              "name": "Sign out",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/editor/{{id}}",
          "url": "/admin/editor/{{id}}"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "starts as a live published item",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Status: published",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "change the title",
          "target": {
            "by": "label",
            "name": "Title"
          },
          "value": "QA RUN {{run_id}} edited"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "save the draft",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Save draft",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "save confirmed",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Saved.",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "live item now carries a pending revision",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Status: published v1 with a pending revision",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "shell",
          "intent": "state: live row untouched, revision stored",
          "script": "check_practice.sh",
          "args": [
            "{{id}}"
          ],
          "capture": {
            "st": "$.status",
            "ver": "$.version",
            "live": "$.title",
            "pend": "$.pending_title",
            "sub": "$.pending_submitted"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "still published",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "st",
            "value": "published"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "version unchanged",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "ver",
            "value": "1"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "live title unchanged",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "live",
            "value": "QA RUN {{run_id}} live"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "edit stored as a draft revision",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "pend",
            "value": "QA RUN {{run_id}} edited"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "revision not submitted",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "sub",
            "value": "false"
          }
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /practices/{{slug}}",
          "url": "/practices/{{slug}}"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "public page still shows the live title",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "QA RUN {{run_id}} live",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "edited title not public",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "QA RUN {{run_id}} edited",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/editor/{{id}}",
          "url": "/admin/editor/{{id}}"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "editor reopens the draft",
          "expected": {
            "kind": "value_equals",
            "target": {
              "by": "label",
              "name": "Title"
            },
            "value": "QA RUN {{run_id}} edited"
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "remove this run's practices",
          "script": "teardown_run.sh",
          "args": [
            "{{run_id}}"
          ]
        }
      ]
    },
    {
      "name": "Editor cannot publish",
      "tags": [
        "admin",
        "editor",
        "negative"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "seed a draft",
          "script": "seed_practice.sh",
          "args": [
            "{{run_id}}",
            "draft",
            "draft"
          ],
          "capture": {
            "id": "$.id",
            "slug": "$.slug"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/login",
          "url": "/admin/login"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "login form",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Admin sign in",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "editor email",
          "target": {
            "by": "label",
            "name": "Email"
          },
          "value": "{{secret:QA_EDITOR_EMAIL}}"
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "editor password",
          "target": {
            "by": "label",
            "name": "Password"
          },
          "value": "{{secret:QA_EDITOR_PASSWORD}}"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "sign in",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Sign in",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "content list shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Content",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "signed in",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "button",
              "name": "Sign out",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/editor/{{id}}",
          "url": "/admin/editor/{{id}}"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "no Publish control for an editor",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "role",
              "role": "button",
              "name": "Publish",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/review",
          "url": "/admin/review"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "review queue redirects an editor to the content list",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Content",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "review queue not shown",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Review queue",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "api",
          "intent": "review endpoint refuses an anonymous call",
          "method": "POST",
          "api_path": "/api/admin/practices/{{id}}/review",
          "status": 401
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/editor/{{id}}",
          "url": "/admin/editor/{{id}}"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "submit for review",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Save and submit for review",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "submitted",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Submitted for review.",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "shell",
          "intent": "state: submitting does not publish",
          "script": "check_practice.sh",
          "args": [
            "{{id}}"
          ],
          "capture": {
            "st": "$.status",
            "ver": "$.version",
            "reviews": "$.reviews"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "waiting for a reviewer, not published",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "st",
            "value": "in_review"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "version unchanged",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "ver",
            "value": "1"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "no review decision recorded",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "reviews",
            "value": "0"
          }
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /practices/{{slug}}",
          "url": "/practices/{{slug}}"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "still not public",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "practice-not-found"
            }
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "remove this run's practices",
          "script": "teardown_run.sh",
          "args": [
            "{{run_id}}"
          ]
        }
      ]
    },
