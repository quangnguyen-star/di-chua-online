        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /",
          "url": "/"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "map is shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "temple-map"
            }
