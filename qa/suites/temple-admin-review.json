          "op": "shell",
          "intent": "remove this run's practices",
          "script": "teardown_run.sh",
          "args": [
            "{{run_id}}"
          ]
        }
      ]
    },
    {
      "name": "Reviewer can request changes and the item stays unpublished",
      "tags": [
        "admin",
        "reviewer",
        "negative"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "seed an in-review practice",
          "script": "seed_practice.sh",
          "args": [
            "{{run_id}}",
            "pending",
            "in_review"
          ],
          "capture": {
            "id": "$.id",
            "slug": "$.slug"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/login",
          "url": "/admin/login"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "login form",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Admin sign in",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "reviewer email",
          "target": {
            "by": "label",
            "name": "Email"
          },
          "value": "{{secret:QA_REVIEWER_EMAIL}}"
        },
        {
          "kind": "action",
          "op": "fill",
          "intent": "reviewer password",
          "target": {
            "by": "label",
            "name": "Password"
          },
          "value": "{{secret:QA_REVIEWER_PASSWORD}}"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "sign in",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Sign in",
            "exact": true
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "content list shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Content",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "signed in",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "button",
              "name": "Sign out",
              "exact": true
            }
          }
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /admin/review",
          "url": "/admin/review"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "our item is queued",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "review-item-{{id}}"
            }
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "request changes (ours is the newest item)",
          "target": {
            "by": "role",
            "role": "button",
            "name": "Request changes",
            "exact": true,
            "nth": 0
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "left the queue",
          "expected": {
            "kind": "hidden",
            "target": {
              "by": "testid",
              "name": "review-item-{{id}}"
            }
          }
        },
        {
          "kind": "action",
          "op": "shell",
          "intent": "state: back to draft, not published",
          "script": "check_practice.sh",
          "args": [
            "{{id}}"
          ],
          "capture": {
            "st": "$.status",
            "reviews": "$.reviews"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "returned to draft",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "st",
            "value": "draft"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "decision recorded",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "reviews",
            "value": "1"
          }
        },
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /practices/{{slug}}",
          "url": "/practices/{{slug}}"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "still not public",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "practice-not-found"
            }
          }
        }
      ],
      "teardown": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "remove this run's practices",
          "script": "teardown_run.sh",
          "args": [
            "{{run_id}}"
          ]
        }
      ]
    },
