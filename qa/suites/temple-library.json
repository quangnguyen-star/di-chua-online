        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "attribution",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "practice-attribution-{{breath_id}}"
            },
            "text": "Nội dung do đội ngũ Chánh niệm mỗi ngày biên soạn."
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "return to the library",
          "target": {
            "by": "testid",
            "name": "practice-return"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "back on the library",
          "expected": {
            "kind": "url_contains",
            "url": "/practices"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "library heading",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Các bài thực hành",
              "exact": true
            }
          }
        }
      ],
      "teardown": []
    },
