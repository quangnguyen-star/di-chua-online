{
  "_about": "Narrow-screen layout across every place, via browser_probe.sh overflow.",
  "schema_version": "1.1.0",
  "run_id": "temple-layout",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 1,
    "video": "fail",
    "default_timeout_ms": 15000,
    "device": "phone"
  },
  "namespace": {
    "run_id": "temple-layout",
    "email": "qa+temple-layout@gomu.ai",
    "tag": "QA RUN temple-layout"
  },
  "scenarios": [
    {
      "name": "360px: no horizontal scroll on /",
      "tags": [
        "layout",
        "responsive"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "measure overflow on /",
          "script": "browser_probe.sh",
          "args": [
            "overflow",
            "{{run_id}}",
            "/"
          ],
          "capture": {
            "over": "$.overflow_px"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "not wider than viewport",
          "expected": {
            "kind": "capture_equals",
            "capture_name": "over",
            "value": "0"
          }
        }
      ],
      "teardown": []
    },
