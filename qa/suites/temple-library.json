{
  "_about": "Public library, detail and unpublished slugs.",
  "schema_version": "1.1.0",
  "run_id": "temple-library",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 2,
    "video": "fail",
    "default_timeout_ms": 15000
  },
  "namespace": {
    "run_id": "temple-library",
    "email": "qa+temple-library@gomu.ai",
    "tag": "QA RUN temple-library"
  },
  "scenarios": [
    {
      "name": "Library lists the three published practices with title, duration, type and summary",
      "tags": [
        "library",
        "happy-path"
      ],
      "setup": [
        {
          "kind": "action",
          "op": "shell",
          "intent": "precondition: the three seeded practices are published",
          "script": "check_library_seed.sh",
          "args": [],
          "capture": {
            "breath_id": "$.breath_id",
            "scan_id": "$.scan_id",
            "walk_id": "$.walk_id"
          }
        }
      ],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /practices",
          "url": "/practices"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "library heading",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "role",
              "role": "heading",
              "name": "Các bài thực hành",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Thở chậm hai phút card listed",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "practice-card-{{breath_id}}"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Thở chậm hai phút: title",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "practice-link-{{breath_id}}"
            },
            "text": "Thở chậm hai phút"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Thở chậm hai phút: summary",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Hai phút để thở chậm lại và trở về với hiện tại.",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Thở chậm hai phút: type and duration Hơi thở · 2 phút",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Hơi thở · 2 phút",
              "exact": true,
              "nth": 0
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Quét cơ thể card listed",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "practice-card-{{scan_id}}"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Quét cơ thể: title",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "practice-link-{{scan_id}}"
            },
            "text": "Quét cơ thể"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Quét cơ thể: summary",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Đi qua từng phần cơ thể bằng sự chú ý dịu dàng.",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Quét cơ thể: type and duration Thiền · 5 phút",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Thiền · 5 phút",
              "exact": true,
              "nth": 0
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Đi bộ chậm card listed",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "practice-card-{{walk_id}}"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Đi bộ chậm: title",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "practice-link-{{walk_id}}"
            },
            "text": "Đi bộ chậm"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Đi bộ chậm: summary",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Mỗi bước chân là một lần trở về.",
              "exact": true
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "Đi bộ chậm: type and duration Thiền · 5 phút",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "text",
              "name": "Thiền · 5 phút",
              "exact": true,
              "nth": 0
            }
          }
        }
      ],
      "teardown": []
    },
