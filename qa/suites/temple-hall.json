{
  "_about": "Hall stop inside the v2 shell: one ritual, keyboard Light/Extinguish/Place, residue note, exit.",
  "schema_version": "1.1.0",
  "run_id": "temple-hall",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 1,
    "video": "fail",
    "default_timeout_ms": 15000
  },
  "namespace": {
    "run_id": "temple-hall",
    "email": "qa+temple-hall@gomu.ai",
    "tag": "QA RUN temple-hall"
  },
  "scenarios": [
    {
      "name": "Hall ritual by keyboard: ready, burning, extinguished, placed",
      "tags": [
        "hall",
        "keyboard",
        "happy-path"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=hall",
          "url": "/visit?stop=hall"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "hall shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "incense-page"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "ready state",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "incense-state"
            },
            "text": "Những nén hương đã đặt sẵn trong lư. Rút một nén của bạn."
          }
        },
        {
          "kind": "action",
          "op": "focus",
          "intent": "focus Thắp nhang",
          "target": {
            "by": "testid",
            "name": "incense-light"
          }
        },
        {
          "kind": "action",
          "op": "press",
          "intent": "Enter activates Thắp nhang",
          "key": "Enter"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "burning",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "incense-state"
            },
            "text": "Nén hương đang cháy. Phẩy nhẹ để tắt ngọn lửa, tàn hương sẽ còn đỏ."
          }
        },
        {
          "kind": "action",
          "op": "focus",
          "intent": "focus Tắt lửa",
          "target": {
            "by": "testid",
            "name": "incense-extinguish"
          }
        },
        {
          "kind": "action",
          "op": "press",
          "intent": "Enter activates Tắt lửa",
          "key": "Enter"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "extinguished with ember kept",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "incense-state"
            },
            "text": "Ngọn lửa đã tắt, tàn hương còn đỏ. Hãy đặt nén hương vào lư."
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "ember stays after the flame is out",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "hall-ember"
            }
          }
        },
        {
          "kind": "action",
          "op": "focus",
          "intent": "focus Đặt nhang vào lư",
          "target": {
            "by": "testid",
            "name": "incense-place"
          }
        },
        {
          "kind": "action",
          "op": "press",
          "intent": "Enter activates Đặt nhang vào lư",
          "key": "Enter"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "placed",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "incense-state"
            },
            "text": "Nén hương đã được đặt vào lư."
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "Gestures: pull the stick, then the lamp is the next target",
      "tags": [
        "hall",
        "gesture"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=hall",
          "url": "/visit?stop=hall"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "pull the stick",
          "target": {
            "by": "testid",
            "name": "hall-stick"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "pulled, waiting for the lamp",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "incense-state"
            },
            "text": "Giữ nén hương bên ngọn đèn dầu cho đến khi nó bén lửa."
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "lamp shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "hall-lamp"
            }
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "Light cannot start twice",
      "tags": [
        "hall",
        "keyboard"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=hall",
          "url": "/visit?stop=hall"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "light",
          "target": {
            "by": "testid",
            "name": "incense-light"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "burning",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "incense-state"
            },
            "text": "Nén hương đang cháy. Phẩy nhẹ để tắt ngọn lửa, tàn hương sẽ còn đỏ."
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "only extinguish is offered while burning",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "incense-extinguish"
            }
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "A placed stick leaves only a note on this device",
      "tags": [
        "hall",
        "persistence"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=hall",
          "url": "/visit?stop=hall"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "light",
          "target": {
            "by": "testid",
            "name": "incense-light"
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "extinguish",
          "target": {
            "by": "testid",
            "name": "incense-extinguish"
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "place",
          "target": {
            "by": "testid",
            "name": "incense-place"
          }
        },
        {
          "kind": "action",
          "op": "reload",
          "intent": "reload the page"
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "spent note shown after reload",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "incense-spent-note"
            }
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "note text",
          "expected": {
            "kind": "text_equals",
            "target": {
              "by": "testid",
              "name": "incense-spent-note"
            },
            "text": "Một nén hương đã được đặt ở đây trước đó."
          }
        }
      ],
      "teardown": []
    },
    {
      "name": "Leaving the hall mid-burn by Thoát goes to the map",
      "tags": [
        "hall",
        "navigation"
      ],
      "setup": [],
      "steps": [
        {
          "kind": "action",
          "op": "navigate",
          "intent": "open /visit?stop=hall",
          "url": "/visit?stop=hall"
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "incense-light",
          "target": {
            "by": "testid",
            "name": "incense-light"
          }
        },
        {
          "kind": "action",
          "op": "click",
          "intent": "Thoát",
          "target": {
            "by": "testid",
            "name": "visit-exit"
          }
        },
        {
          "kind": "assert",
          "op": "assert",
          "intent": "temple-map shown",
          "expected": {
            "kind": "visible",
            "target": {
              "by": "testid",
              "name": "temple-map"
            }
          }
        }
      ],
      "teardown": []
    }
  ]
}
