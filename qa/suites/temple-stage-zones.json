{
  "_about": "Shell zones and one gate. Every stop renders the stage zones; the gate stop and the home map draw the same Tam Quan art. Asserts nothing about the removed river leak, per-stop fog or standalone lantern look. Not executed in the authoring session (no browser).",
  "schema_version": "1.1.0",
  "run_id": "temple-stage-zones",
  "config": {
    "base_url": "http://localhost:3000",
    "parallelism": 1,
    "video": "fail",
    "default_timeout_ms": 15000
